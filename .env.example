# Copy to .env for local development
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use SQLite locally. Examples:
# DATABASE_URL=postgres://user:password@localhost:5432/space_risk
# DATABASE_URL=mysql://user:password@localhost:3306/space_risk   (pip install mysqlclient)
DATABASE_URL=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: stronger model only for Karakalpak chat answers
OPENROUTER_MODEL_KAA=

# Created by `python manage.py seed`
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@spacerisk.uz
DJANGO_SUPERUSER_PASSWORD=change-me
